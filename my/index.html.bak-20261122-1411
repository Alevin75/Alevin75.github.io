<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Моя бронь — Глэмпинг «Остров»</title>
<meta name="robots" content="noindex, nofollow">
<style>
  :root{
    --ink:#1d2b24; --ink-soft:#5a6b62; --paper:#f7f4ec; --card:#ffffff;
    --edge:#e2dccd; --green:#2f6b4f; --green-soft:#e8f0ea; --gold:#b08d4f;
    --chip:#f1ede1;
  }
  *{box-sizing:border-box}
  body{
    margin:0; background:var(--paper); color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
    line-height:1.5; -webkit-text-size-adjust:100%;
  }
  .wrap{max-width:720px;margin:0 auto;padding:16px 16px 40px}
  header.top{display:flex;align-items:center;gap:12px;padding:8px 0 16px}
  .logo{
    width:44px;height:44px;border-radius:12px;background:var(--green);
    color:#fff;display:flex;align-items:center;justify-content:center;
    font-weight:700;font-size:20px;flex:0 0 auto;
  }
  .brand b{display:block;font-size:17px;letter-spacing:.2px}
  .brand span{display:block;font-size:12.5px;color:var(--ink-soft)}
  h1{font-size:22px;margin:18px 0 6px}
  h2{font-size:17px;margin:0 0 10px}
  p{margin:0 0 10px}
  .muted{color:var(--ink-soft);font-size:14px}
  .card{
    background:var(--card);border:1px solid var(--edge);border-radius:16px;
    padding:16px;margin:0 0 14px;box-shadow:0 1px 2px rgba(29,43,36,.04);
  }
  label{display:block;font-size:13.5px;color:var(--ink-soft);margin:12px 0 5px}
  textarea,input{
    width:100%;border:1px solid var(--edge);border-radius:12px;background:#fff;
    padding:12px;font-size:16px;color:var(--ink);font-family:inherit;
  }
  textarea{min-height:96px;resize:vertical}
  button{
    font:inherit;border:0;border-radius:12px;padding:13px 18px;cursor:pointer;
    background:var(--green);color:#fff;font-weight:600;width:100%;margin-top:14px;
  }
  button.ghost{background:var(--green-soft);color:var(--green);border:1px solid #cfe0d5}
  button.mini{width:auto;padding:10px 14px;margin:0;font-size:14px}
  .row{display:flex;gap:10px;flex-wrap:wrap}
  .row > *{flex:1 1 160px}
  dl.booking{margin:0}
  dl.booking div{display:flex;justify-content:space-between;gap:12px;padding:7px 0;border-bottom:1px dashed var(--edge)}
  dl.booking div:last-child{border-bottom:0}
  dl.booking dt{color:var(--ink-soft);font-size:14px}
  dl.booking dd{margin:0;font-weight:600;text-align:right}
  ul.notes{margin:6px 0 0;padding-left:20px}
  ul.notes li{margin:5px 0}
  .pill{display:inline-block;background:var(--chip);border-radius:999px;padding:5px 11px;font-size:13px;margin:0 6px 6px 0}
  .msg{max-width:82%;border-radius:14px;padding:9px 12px;margin:7px 0;font-size:15px;word-wrap:break-word}
  .msg.guest{background:var(--green-soft);border:1px solid #cfe0d5;margin-left:auto}
  .msg.staff{background:#fff;border:1px solid var(--edge)}
  .msg time{display:block;font-size:11px;color:var(--ink-soft);margin-top:3px}
  #chat{max-height:340px;overflow-y:auto;padding:4px}
  .chatbar{display:flex;gap:8px;margin-top:10px}
  .chatbar input{flex:1}
  .chatbar button{width:auto;margin:0;padding:12px 16px}
  .status{font-size:13px;color:var(--ink-soft);min-height:18px;margin-top:8px}
  .status.err{color:#a33}
  a{color:var(--green)}
  .links a{display:inline-block;margin:0 10px 8px 0;font-size:14.5px}
  footer{text-align:center;color:var(--ink-soft);font-size:12.5px;margin-top:22px}
  .hidden{display:none}
</style>
</head>
<body>
<div class="wrap">

  <header class="top">
    <div class="logo">О</div>
    <div class="brand">
      <b>Глэмпинг «Остров»</b>
      <span>Моя бронь и связь с нами</span>
    </div>
  </header>

  <!-- ================= ВХОД ================= -->
  <section id="view-login">
    <div class="card">
      <h1>Ваша бронь</h1>
      <p class="muted">Вставьте сюда письмо о брони целиком — номер найдём сами. Или впишите номер вручную.</p>

      <label for="letter">Письмо о брони или номер брони</label>
      <textarea id="letter" placeholder="Например: 20261121-51481-473654003"></textarea>
      <div class="row">
        <button class="ghost mini" id="btn-paste" type="button">Вставить из буфера</button>
      </div>

      <label for="surname">Фамилия (как в брони)</label>
      <input id="surname" autocomplete="off" placeholder="Иванов" />

      <button id="btn-login" type="button">Войти</button>
      <div class="status" id="login-status"></div>
    </div>
    <p class="muted">Если не получается войти — напишите нам в мессенджер или позвоните на ресепшен
      <a href="tel:+79250270015">+7 (925) 027-00-15</a> (круглосуточно).</p>
  </section>

  <!-- ================= БРОНЬ ================= -->
  <section id="view-booking" class="hidden">
    <h1 id="hi">Здравствуйте!</h1>
    <p class="muted">Мы уже готовимся к вашему приезду.</p>

    <div class="card">
      <h2>Ваша бронь</h2>
      <dl class="booking" id="booking-dl"></dl>
    </div>

    <div class="card">
      <h2>Важная информация</h2>
      <ul class="notes">
        <li>Заезд с <b>15:00</b>, выезд до <b>12:00</b></li>
        <li>Ключи будут в замке; при выезде оставьте их в замке</li>
        <li id="breakfast-bullet">Завтраки: <b>09:00–11:00</b>, ресторан «Трапезная»</li>
        <li id="bath-bullet">Топка бани, чана и купели — 1 раз в день включена в проживание, дополнительная 1500 ₽, самое позднее <b>22:00</b></li>
        <li>Заселение — по паспортам всех гостей</li>
      </ul>
      <p class="muted" style="margin-top:12px">Адрес: Московская область, Ленинский г.о., село Остров, улица Царскосельская, дом 1Б</p>
      <div class="links">
        <a href="https://yandex.ru/maps/?text=%D0%9C%D0%BE%D1%81%D0%BA%D0%BE%D0%B2%D1%81%D0%BA%D0%B0%D1%8F%20%D0%BE%D0%B1%D0%BB%D0%B0%D1%81%D1%82%D1%8C%20%D0%9B%D0%B5%D0%BD%D0%B8%D0%BD%D1%81%D0%BA%D0%B8%D0%B9%20%D1%81%D0%B5%D0%BB%D0%BE%20%D0%9E%D1%81%D1%82%D1%80%D0%BE%D0%B2%20%D1%83%D0%BB%D0%B8%D1%86%D0%B0%20%D0%A6%D0%B0%D1%80%D1%81%D0%BA%D0%BE%D1%81%D0%B5%D0%BB%D1%8C%D1%81%D0%BA%D0%B0%D1%8F%201" target="_blank" rel="noopener">Маршрут на карте</a>
        <a href="tel:+79250270015">Ресепшен: +7 (925) 027-00-15</a>
        <a href="https://suite.ostrovglamping.ru/app" target="_blank" rel="noopener">Приложение: карта, услуги, газета</a>
      </div>
    </div>

    <div class="card">
      <h2 id="asks-title">Просьбы</h2>
      <p class="muted">Это нужно, чтобы всё было готово к вашему приезду.</p>
      <div class="row">
        <div id="bath-block">
          <label for="bath">Во сколько натопить баню?</label>
          <input id="bath" type="time" min="08:00" max="22:00" step="1800" />
        </div>
        <div id="chan-block">
          <label for="chan">Во сколько натопить чан?</label>
          <input id="chan" type="time" min="08:00" max="22:00" step="1800" />
        </div>
        <div id="kupel-block">
          <label for="kupel">Во сколько натопить купель?</label>
          <input id="kupel" type="time" min="08:00" max="22:00" step="1800" />
        </div>
        <div>
          <label for="car">Номер машины или такси</label>
          <input id="car" placeholder="А123ВС77" autocomplete="off" />
          <p class="muted" style="font-size:12.5px;margin-top:6px">Нужен для проезда через ворота усадьбы.</p>
        </div>
      </div>
      <button id="btn-save" type="button">Сохранить</button>
      <div class="status" id="save-status"></div>
    </div>

    <div class="card">
      <h2>Написать нам</h2>
      <p class="muted">Ответим здесь же. Пишем мы сами, поэтому отвечаем с 09:00 до 21:00, ночью — утром.</p>
      <div id="chat"></div>
      <div class="chatbar">
        <input id="chat-input" placeholder="Ваше сообщение" autocomplete="off" />
        <button id="btn-send" type="button">Отправить</button>
      </div>
      <div class="status" id="chat-status"></div>
      <p class="muted" style="margin-top:10px">Можно и в мессенджер:
        <a href="https://t.me/Ostrovglamping" target="_blank" rel="noopener">Telegram</a> ·
        <a href="https://max.ru/u/f9LHodD0cOJvu47I3fRRTXnnBTo7ea5GBUWc13eXZEkxPu3IX1sBEz4fnr8" target="_blank" rel="noopener">MAX</a>
      </p>
    </div>

    <button class="ghost" id="btn-logout" type="button">Выйти из личной страницы</button>
    <footer>Глэмпинг «Остров» · <a href="https://ostrovglamping.ru" target="_blank" rel="noopener">ostrovglamping.ru</a></footer>
  </section>

</div>

<script>
(function(){
  var API = 'https://nosnpozzgtnnkyghcwpq.supabase.co/rest/v1/rpc/';
  var KEY = 'sb_publishable_ZdidoEqbCaL88jxgPUR0hQ_KQ6COMaU';
  var TOKEN_KEY = 'oc_guest_token';
  var MONTHS = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
  var lastId = 0;
  var poller = null;

  function $(id){ return document.getElementById(id); }

  function rpc(name, payload){
    return fetch(API + name, {
      method: 'POST',
      headers: {'apikey': KEY, 'Content-Type': 'application/json'},
      body: JSON.stringify(payload || {})
    }).then(function(r){
      if (!r.ok) { throw new Error('HTTP ' + r.status); }
      return r.json();
    });
  }

  function say(box, text, isError){
    box.textContent = text || '';
    box.className = 'status' + (isError ? ' err' : '');
  }

  function fmtDate(s){
    if (!s) { return '—'; }
    var p = String(s).slice(0,10).split('-');
    if (p.length < 3) { return s; }
    return parseInt(p[2],10) + ' ' + MONTHS[parseInt(p[1],10)-1];
  }

  function fmtTime(iso){
    if (!iso) { return ''; }
    try {
      return new Date(iso).toLocaleTimeString('ru-RU', {hour:'2-digit', minute:'2-digit', timeZone:'Europe/Moscow'});
    } catch(e){ return ''; }
  }

  function token(){ return localStorage.getItem(TOKEN_KEY) || ''; }
  function setToken(t){ try { localStorage.setItem(TOKEN_KEY, t); } catch(e){} }
  function clearToken(){ try { localStorage.removeItem(TOKEN_KEY); } catch(e){} }

  function extractNumber(text){
    var raw = String(text || '');
    var m = raw.match(/(\d{8})\D{0,3}(\d{5})\D{0,3}(\d{2,})/);
    if (m) { return m[1] + '-' + m[2] + '-' + m[3]; }
    var digits = raw.replace(/\D/g, '');
    if (digits.length >= 15) { return digits; }
    return raw.trim();
  }

  function showLogin(msg){
    $('view-booking').classList.add('hidden');
    $('view-login').classList.remove('hidden');
    if (poller) { clearInterval(poller); poller = null; }
    if (msg) { say($('login-status'), msg, true); }
  }

  function showBooking(){
    $('view-login').classList.add('hidden');
    $('view-booking').classList.remove('hidden');
    window.scrollTo(0,0);
  }

  function renderBooking(b){
    var first = String(b.guest_name || '').split(' ')[0];
    $('hi').textContent = 'Здравствуйте, ' + (first || '') + '!';

    // Баня, чан и купель есть не у всех: спрашиваем только про то, что есть у объекта.
    // Джакузи не спрашиваем — оно электрическое.
    var hasBath = b.has_bath === true;
    var hasChan = b.has_chan === true;
    var hasKupel = b.has_kupel === true;
    var shows = {'bath-block': hasBath, 'chan-block': hasChan, 'kupel-block': hasKupel};
    Object.keys(shows).forEach(function(id){
      var el = $(id);
      if (el) { el.style.display = shows[id] ? '' : 'none'; }
    });
    // Просьб столько: сколько топок нужно плюс номер машины (он нужен всегда).
    var asksCount = (hasBath ? 1 : 0) + (hasChan ? 1 : 0) + (hasKupel ? 1 : 0) + 1;
    var asks = $('asks-title');
    if (asks) {
      asks.textContent = asksCount === 1 ? 'Одна просьба' : (asksCount + ' просьбы');
    }
    var bathBullet = $('bath-bullet');
    if (bathBullet) {
      bathBullet.style.display = (hasBath || hasChan || hasKupel) ? '' : 'none';
    }

    // Завтраки. Правило то же, что в OstrovControl (database.py, has_breakfast):
    // «с завтраком» или «+ завтрак» и при этом НЕ «без завтрака».
    // Если завтраки не входят — вместо строки про «Трапезную» пишем про ресторан по меню,
    // чтобы гость не ждал завтрака, которого в тарифе нет.
    var tr = String(b.tariff || '').toLowerCase();
    var byTariff = (tr.indexOf('с завтраком') >= 0 || tr.indexOf('+ завтрак') >= 0)
                   && tr.indexOf('без завтрака') < 0;
    var hasBreakfast = byTariff || (parseInt(b.breakfasts, 10) > 0);
    var bfBullet = $('breakfast-bullet');
    if (bfBullet) {
      bfBullet.innerHTML = hasBreakfast
        ? 'Завтраки: <b>09:00–11:00</b>, ресторан «Трапезная»'
        : 'На территории работает ресторан «Сыроварня» — по меню';
    }
    var dl = $('booking-dl');
    dl.innerHTML = '';
    // Название объекта в TravelLine часто уже содержит номер («Домик №7 с баней и джакузи»).
    // Тогда второй номер («№ 4») только путает гостя. Правило то же, что в программе
    // (database.py, full_room_label): объекты с баней, чаном, джакузи, купелью или бочкой
    // показываем без добавочного номера.
    var room = String(b.room || '');
    var low = room.toLowerCase();
    var markers = ['с баней', 'с чаном', 'с джакузи', 'с купелью', 'с бочкой',
                   'пати', 'кемпинг', 'костров'];
    var keep = markers.some(function(m){ return low.indexOf(m) >= 0; });
    if (b.room_number && !keep) { room = room + ' № ' + b.room_number; }
    if (!room && b.room_number) { room = '№ ' + b.room_number; }
    var rows = [
      ['Объект', room || '—'],
      ['Заезд', fmtDate(b.checkin_date) + ', с 15:00'],
      ['Выезд', fmtDate(b.checkout_date) + ', до 12:00'],
      ['Гостей', b.guests_count ? String(b.guests_count) : '—'],
      ['Тариф', b.tariff || '—'],
      ['Завтраки', hasBreakfast ? 'включены в тариф' : 'не включены']
    ];
    rows.forEach(function(pair){
      var d = document.createElement('div');
      var dt = document.createElement('dt');
      dt.textContent = pair[0];
      var dd = document.createElement('dd');
      dd.textContent = pair[1];
      d.appendChild(dt); d.appendChild(dd);
      dl.appendChild(d);
    });
  }

  function loadAnswers(){
    rpc('oc_guest_answers_get', {p_token: token()}).then(function(rows){
      if (rows && rows.length) {
        if (rows[0].fire_time) { $('bath').value = rows[0].fire_time; }
        if (rows[0].chan_time) { $('chan').value = rows[0].chan_time; }
        if (rows[0].kupel_time) { $('kupel').value = rows[0].kupel_time; }
        if (rows[0].car_number) { $('car').value = rows[0].car_number; }
      }
    }).catch(function(){});
  }

  function addMessage(m){
    var chat = $('chat');
    var div = document.createElement('div');
    div.className = 'msg ' + (m.author === 'staff' ? 'staff' : 'guest');
    var t = document.createElement('time');
    t.textContent = (m.author === 'staff' ? 'Мы · ' : 'Вы · ') + fmtTime(m.created_at);
    div.appendChild(document.createTextNode(m.body || ''));
    div.appendChild(t);
    chat.appendChild(div);
    chat.scrollTop = chat.scrollHeight;
  }

  function loadMessages(){
    return rpc('oc_guest_chat_list', {p_token: token(), p_since: lastId}).then(function(rows){
      if (rows && rows.length) {
        rows.forEach(function(m){
          var id = parseInt(m.id, 10);
          if (id > lastId) { lastId = id; }
          addMessage(m);
        });
      }
    });
  }

  function enter(booking){
    renderBooking(booking);
    showBooking();
    loadAnswers();
    loadMessages().catch(function(){});
    if (poller) { clearInterval(poller); }
    poller = setInterval(function(){
      if (document.hidden || token() === '') { return; }
      loadMessages().catch(function(){});
    }, 5000);
  }

  function me(){
    rpc('oc_guest_me', {p_token: token()}).then(function(rows){
      if (rows && rows.length) { enter(rows[0]); }
      else { clearToken(); showLogin(''); }
    }).catch(function(){ showLogin('Нет связи с базой. Проверьте интернет.'); });
  }

  // --- вход
  $('btn-login').addEventListener('click', function(){
    var number = extractNumber($('letter').value);
    var surname = $('surname').value.trim();
    if (number.replace(/\D/g,'').length < 6 || surname.length < 2) {
      say($('login-status'), 'Впишите номер брони и фамилию.', true);
      return;
    }
    say($('login-status'), 'Проверяю…');
    rpc('oc_guest_login', {p_number: number, p_last: surname}).then(function(rows){
      if (rows && rows.length && rows[0].token) {
        setToken(rows[0].token);
        say($('login-status'), '');
        enter(rows[0]);
      } else {
        say($('login-status'), 'Такой брони не нашли. Проверьте номер и фамилию — или напишите нам.', true);
      }
    }).catch(function(){
      say($('login-status'), 'Бронирование сейчас не отвечает. Попробуйте через минуту.', true);
    });
  });

  $('btn-paste').addEventListener('click', function(){
    var ok = function(text){
      if (!text) { return; }
      var el = $('letter');
      el.value = (el.value ? el.value + ' ' : '') + text;
      say($('login-status'), 'Вставили. Проверьте фамилию и нажмите «Войти».');
    };
    if (navigator.clipboard && navigator.clipboard.readText) {
      navigator.clipboard.readText().then(ok).catch(function(){
        say($('login-status'), 'Браузер не дал доступ к буферу. Нажмите в поле и удерживайте — выберите «Вставить».', true);
      });
    } else {
      say($('login-status'), 'Нажмите в поле и удерживайте — выберите «Вставить».');
    }
  });

  $('surname').addEventListener('keydown', function(e){
    if (e.key === 'Enter') { $('btn-login').click(); }
  });

  // --- ответы
  $('btn-save').addEventListener('click', function(){
    var bath = $('bath') ? $('bath').value : '';
    var chan = $('chan') ? $('chan').value : '';
    var kupel = $('kupel') ? $('kupel').value : '';
    var car = $('car').value.trim();
    if (!bath && !chan && !kupel && !car) {
      say($('save-status'), 'Заполните хотя бы одно поле.', true);
      return;
    }
    say($('save-status'), 'Сохраняю…');
    rpc('oc_guest_booking_answer', {p_token: token(), p_bath: bath, p_chan: chan,
                                   p_kupel: kupel, p_car: car}).then(function(rows){
      var ok = rows && rows.length && rows[0].ok;
      say($('save-status'), ok ? 'Спасибо! Мы всё увидели.' : 'Не сохранилось, попробуйте ещё раз.', !ok);
    }).catch(function(){ say($('save-status'), 'Нет связи. Попробуйте позже.', true); });
  });

  // --- чат
  function send(){
    var text = $('chat-input').value.trim();
    if (!text) { return; }
    $('chat-input').value = '';
    say($('chat-status'), 'Отправляю…');
    rpc('oc_guest_chat_send', {p_token: token(), p_body: text}).then(function(rows){
      var ok = rows && rows.length && rows[0].ok;
      if (ok) { say($('chat-status'), ''); loadMessages().catch(function(){}); }
      else { say($('chat-status'), 'Сообщение не ушло. Попробуйте ещё раз.', true); }
    }).catch(function(){ say($('chat-status'), 'Нет связи. Попробуйте позже.', true); });
  }
  $('btn-send').addEventListener('click', send);
  $('chat-input').addEventListener('keydown', function(e){ if (e.key === 'Enter') { send(); } });

  $('btn-logout').addEventListener('click', function(){
    clearToken();
    lastId = 0;
    $('chat').innerHTML = '';
    $('letter').value = '';
    $('surname').value = '';
